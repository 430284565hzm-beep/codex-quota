<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
    <ImageView android:id="@id/widget_material" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_preview_bg" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Codex 余量" android:textColor="#27363D" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:layout_marginBottom="6dp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@id/widget_primary_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="当前窗口" android:textColor="#66777E" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@id/widget_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="—" android:textColor="#27363D" android:textSize="28sp" android:fontFamily="sans-serif-light" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@id/widget_secondary_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="长周期" android:textColor="#66777E" android:textSize="10sp" android:layout_marginTop="10dp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@id/widget_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="—" android:textColor="#27363D" android:textSize="28sp" android:fontFamily="sans-serif-light" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" />
        <ImageView android:id="@id/widget_refresh" android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/ic_refresh" android:padding="6dp" android:contentDescription="立即刷新用量" />
        <TextView android:id="@id/widget_bank" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center" android:text="储备 —" android:textColor="#388D7D" android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
