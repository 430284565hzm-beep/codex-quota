<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 余量 · WPF" Width="300" Height="208"
        MinWidth="260" MinHeight="184"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" ShowInTaskbar="False"
        Background="Transparent" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="12" TextOptions.TextFormattingMode="Display" Typography.NumeralAlignment="Tabular"
        Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#202426"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#636D70"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#7A8587"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#30FFFFFF"/>
        <SolidColorBrush x:Key="EdgeBrush" Color="#90FFFFFF"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#23758080"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#318A74"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#267B858A"/>
        <SolidColorBrush x:Key="PressedBrush" Color="#427B858A"/>
        <SolidColorBrush x:Key="MenuBrush" Color="#F7F0F3F3"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="#26727C80"/>
        <LinearGradientBrush x:Key="RimBrush" StartPoint="0,0" EndPoint="0.85,1">
            <GradientStop Color="#DAFFFFFF" Offset="0"/>
            <GradientStop Color="#52FFFFFF" Offset="0.42"/>
            <GradientStop Color="#20FFFFFF" Offset="0.68"/>
            <GradientStop Color="#80FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                CornerRadius="13" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource PressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource TrackBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="True">
                                <Border Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                                <Border x:Name="RefillLight" CornerRadius="2" Opacity="0">
                                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#28FFFFFF" Offset="0"/><GradientStop Color="#0EFFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background>
                                </Border>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="Tag" Value="restoring"><Setter TargetName="RefillLight" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource EdgeBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Margin="10" Padding="5" CornerRadius="12"
                                Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#000000"/>
                            </Border.Effect>
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuRow" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="18"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Icon" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  TextElement.Foreground="{DynamicResource MutedBrush}"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontSize="11"
                                           Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" Margin="14,0,3,0"/>
                                <TextBlock x:Name="CheckGlyph" Grid.Column="3" Text="&#xE73E;" Visibility="Hidden"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Height" Value="9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,0" VerticalAlignment="Center" Background="{DynamicResource SeparatorBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Canvas x:Name="MotionCanvas" ClipToBounds="True">
    <Border x:Name="Outer" Background="Transparent" Padding="0" Width="290" Height="198"
            Canvas.Left="5" Canvas.Top="5" CornerRadius="22">
        <Grid>
            <Border x:Name="GlassShadow" Background="#22FFFFFF" CornerRadius="22" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#07121D" BlurRadius="13" ShadowDepth="2" Direction="270" Opacity="0.42"/>
                </Border.Effect>
            </Border>
            <Border x:Name="GlassBackdrop" CornerRadius="24" IsHitTestVisible="False"/>
            <Border x:Name="GlassSurface" Background="{DynamicResource SurfaceBrush}" CornerRadius="24" IsHitTestVisible="False"/>
            <Border x:Name="GlassDepth" BorderBrush="{DynamicResource DepthBrush}" BorderThickness="1.5" CornerRadius="24" Margin="1" IsHitTestVisible="False"/>
            <Border x:Name="GlassRim" BorderBrush="{DynamicResource RimBrush}" BorderThickness="1" CornerRadius="24" IsHitTestVisible="False"/>
            <Grid x:Name="ContentClip" ClipToBounds="True">
            <Grid x:Name="DockPeek" Visibility="Collapsed" Background="Transparent" Margin="8,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="17"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="PeekGroupA" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="PeekLabelA" Text="5 小时" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PeekA" Text="—" FontSize="18" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
                <Border x:Name="PeekDivider" Grid.Row="1" Width="26" Height="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SeparatorBrush}" IsHitTestVisible="False"/>
                <StackPanel x:Name="PeekGroupB" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="PeekLabelB" Text="每周" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PeekB" Text="—" FontSize="18" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="FullContent" Margin="18,12,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <Grid x:Name="Header" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Title" Text="Codex 余量" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="Plan" Grid.Column="1" Text="" MaxWidth="56" TextTrimming="CharacterEllipsis" Margin="7,2,0,0" FontSize="10" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,-4,0">
                    <Button x:Name="Pin" Content="&#xE718;" ToolTip="取消置顶" AutomationProperties.Name="置顶"/>
                    <Button x:Name="Refresh" Content="&#xE72C;" ToolTip="刷新" AutomationProperties.Name="刷新"/>
                    <Button x:Name="More" Content="&#xE712;" ToolTip="菜单" AutomationProperties.Name="菜单" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="Metrics" Grid.Row="1" MaxWidth="720" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="MetricA" Grid.Row="0" Grid.Column="0" Background="Transparent">
                    <Grid x:Name="CompactA" VerticalAlignment="Center" Margin="0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LabelA" Text="5 小时" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ValueA" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="RemainingA" Text="剩余" FontSize="10" Foreground="{DynamicResource FaintBrush}" Margin="5,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar x:Name="BarA" Grid.Row="1" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="ResetA" Grid.Row="2" Text="" FontSize="10" Foreground="{DynamicResource FaintBrush}"
                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                    </Grid>
                    <StackPanel x:Name="DetailA" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="DetailLabelA" Text="5 小时" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                        <Grid x:Name="RingA" Width="112" Height="112" Margin="0,10,0,8">
                            <Ellipse Margin="3" Stroke="{DynamicResource TrackBrush}" StrokeThickness="5"/>
                            <Path x:Name="ArcA" Stroke="{DynamicResource AccentBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="DetailValueA" Text="—" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="剩余" FontSize="10" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="DetailResetA" Text="" FontSize="10" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="MetricB" Grid.Row="1" Grid.Column="0" Background="Transparent">
                    <Grid x:Name="CompactB" VerticalAlignment="Center" Margin="0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LabelB" Text="每周" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ValueB" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="RemainingB" Text="剩余" FontSize="10" Foreground="{DynamicResource FaintBrush}" Margin="5,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar x:Name="BarB" Grid.Row="1" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="ResetB" Grid.Row="2" Text="" FontSize="10" Foreground="{DynamicResource FaintBrush}"
                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                    </Grid>
                    <StackPanel x:Name="DetailB" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="DetailLabelB" Text="每周" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                        <Grid x:Name="RingB" Width="112" Height="112" Margin="0,10,0,8">
                            <Ellipse Margin="3" Stroke="{DynamicResource TrackBrush}" StrokeThickness="5"/>
                            <Path x:Name="ArcB" Stroke="{DynamicResource AccentBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="DetailValueB" Text="—" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="剩余" FontSize="10" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="DetailResetB" Text="" FontSize="10" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
                <Border x:Name="Divider" Grid.RowSpan="2" Grid.ColumnSpan="2" Width="1" Margin="0,12"
                        HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource SeparatorBrush}"
                        IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>

            <Grid x:Name="Footer" Grid.Row="2" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="4" Height="4" Fill="{DynamicResource FaintBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock x:Name="Status" Grid.Column="1" Text="正在连接…" FontSize="10" Foreground="{DynamicResource FaintBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,5,0"/>
                <Button x:Name="Bank" Grid.Column="2" Width="72" Height="20" Foreground="{DynamicResource AccentBrush}"
                        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="10"
                        AutomationProperties.Name="储备重置" ToolTip="查看和使用 Banked reset" RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Button.RenderTransform>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="BankGlyph" Text="&#xE777;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="BankCaption" Text="储备 —" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <Border x:Name="BankSheet" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource MenuBrush}"
                    CornerRadius="14" Padding="10" Height="116" MaxWidth="360" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="储备重置" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="BankCount" Text="— 次" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock x:Name="BankMessage" Grid.Row="1" Text="正在读取储备次数…" TextWrapping="Wrap" FontSize="10" LineHeight="14"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,3"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BankCancel" Content="返回" Width="48" Height="24" FontSize="10"
                                FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" Margin="0,0,4,0"/>
                        <Button x:Name="BankConfirm" Content="使用 1 次" Width="86" Height="24" FontSize="10" IsEnabled="False"
                                FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" Background="{DynamicResource HoverBrush}"
                                Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
            </Grid>
            <Grid x:Name="FxHost" IsHitTestVisible="False" ClipToBounds="True"/>
        </Grid>
    </Border>
    </Canvas>
</Window>
